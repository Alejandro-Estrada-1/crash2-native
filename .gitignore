# --- Game data and build outputs: NEVER in git ---
# Paths are root-anchored (leading "/") so folders with the same name
# elsewhere (such as tools/ghidra/) are not accidentally ignored.
# No trailing "/": ensures symlinks are ignored as well
# (disc is a symlink to ../privado/disc).
/disc
/generated
/build
/build-*
/ghidra

# psxrecomp_cli.py staging areas containing disc bytes: extracted EXE and
# SYSTEM.CNF ([prepare_disc] out_dir), caches, and local BIOS dumps.
/prepared_disc
/.cache
/bios
/saves
/analysis

# Local runtime config (user paths)
bios.cfg
disc.cfg
rom.cfg
settings.toml

# Runtime artifacts written when launched from repo root
overlay_captures.json
psx_crash.txt
psx_last_run_report.json
psx_screenshot.bmp
psx_freeze_heartbeat.json
.psxrecomp_last_generate
.psxrecomp_write_probe
starvation_dump.jsonl
# probe_disc.py output: contains local filesystem paths
/disc_probe.json

# Disc images and extracted executables anywhere
*.cue
*.bin
*.chd
*.iso
*.img
*.sub
*.ccd
SCUS_*
SCPH*.BIN

# Ghidra projects outside /ghidra/
*.gpr
*.rep/

# Emulator memory cards and save states
*.mcd
*.mcr
*.sstate

# Misc
*.AppImage
__pycache__/
*.log
/tools/verify-disc/target
