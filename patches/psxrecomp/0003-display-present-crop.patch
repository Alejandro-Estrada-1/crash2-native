     return layout.valid ? layout.offset_y : 0;
 }
 
+/* Pack an explicit positive numerator/denominator aspect override into the
+ * legacy int force_4_3 present parameter while preserving 0 (configured
+ * aspect) and 1 (4:3) semantics for existing callers and tests. */
+#define PSX_PRESENT_ASPECT_CUSTOM_BIT (1u << 30)
+#define PSX_PRESENT_ASPECT_FIELD_MAX  0x7FFFu
+
+static inline int psx_present_aspect_pack(int num, int den)
+{
+    if (num <= 0 || den <= 0 ||
+        num > (int)PSX_PRESENT_ASPECT_FIELD_MAX ||
+        den > (int)PSX_PRESENT_ASPECT_FIELD_MAX)
+        return 1;
+    if ((int64_t)num * 3 == (int64_t)den * 4)
+        return 1;
+    return (int)(PSX_PRESENT_ASPECT_CUSTOM_BIT |
+                 (((uint32_t)num & PSX_PRESENT_ASPECT_FIELD_MAX) << 15) |
+                 ((uint32_t)den & PSX_PRESENT_ASPECT_FIELD_MAX));
+}
+
+static inline void psx_present_aspect_unpack(int flag, int *num, int *den)
+{
+    if (((uint32_t)flag & PSX_PRESENT_ASPECT_CUSTOM_BIT) != 0u) {
+        int n = (int)(((uint32_t)flag >> 15) & PSX_PRESENT_ASPECT_FIELD_MAX);
+        int d = (int)((uint32_t)flag & PSX_PRESENT_ASPECT_FIELD_MAX);
+        if (n > 0 && d > 0) {
+            if (num) *num = n;
+            if (den) *den = d;
+            return;
+        }
+    }
+    if (num) *num = 4;
+    if (den) *den = 3;
+}
+
+/* Compute reduced unstretched presentation aspect when cropping `full_h` active
+ * scanlines down to `crop_h` inside a `base_num:base_den` display raster. */
+static inline void psx_present_cropped_aspect(
+    int base_num, int base_den, uint32_t full_h, uint32_t crop_h,
+    int *out_num, int *out_den)
+{
+    int64_t n, d, a, b;
+    if (base_num <= 0 || base_den <= 0 || full_h == 0u || crop_h == 0u ||
+        crop_h >= full_h) {
+        if (out_num) *out_num = base_num > 0 ? base_num : 4;
+        if (out_den) *out_den = base_den > 0 ? base_den : 3;
+        return;
+    }
+    n = (int64_t)base_num * (int64_t)full_h;
+    d = (int64_t)base_den * (int64_t)crop_h;
+    a = n;
+    b = d;
+    while (b != 0) {
+        int64_t t = a % b;
+        a = b;
+        b = t;
+    }
+    if (a > 0) {
+        n /= a;
+        d /= a;
+    }
+    while ((n > (int64_t)PSX_PRESENT_ASPECT_FIELD_MAX ||
+            d > (int64_t)PSX_PRESENT_ASPECT_FIELD_MAX) && d > 1) {
+        n /= 2;
+        d /= 2;
+    }
+    if (n < 1) n = 1;
+    if (d < 1) d = 1;
+    if (out_num) *out_num = (int)n;
+    if (out_den) *out_den = (int)d;
+}
+
 #endif
