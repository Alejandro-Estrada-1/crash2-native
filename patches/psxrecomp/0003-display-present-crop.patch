index 829ae838..02805dd8 100644
--- a/runtime/src/gpu.c
+++ b/runtime/src/gpu.c
@@ -8699,3 +8699,38 @@ uint64_t gpu_pass_state_hash(void) {
 
 uint16_t* gpu_get_vram_ptr(void){ return vram; }
 uint32_t  gpu_get_vram_bytes(void){ return (uint32_t)sizeof(vram); }
+
+static PsxDisplayPresentCropCb s_present_crop_cb = NULL;
+
+void gpu_set_present_crop_callback(PsxDisplayPresentCropCb cb) {
+    s_present_crop_cb = cb;
+}
+
+int gpu_apply_present_crop(GpuDisplayInfo *io, int base_num, int base_den,
+                           int *out_num, int *out_den) {
+    PsxDisplayPresentCrop crop;
+    int bn = base_num > 0 && base_den > 0 ? base_num : 4;
+    int bd = base_num > 0 && base_den > 0 ? base_den : 3;
+    if (out_num) *out_num = bn;
+    if (out_den) *out_den = bd;
+    if (!io || !s_present_crop_cb) return 0;
+    if (io->disabled || io->depth24 || io->width == 0u || io->height == 0u)
+        return 0;
+    memset(&crop, 0, sizeof(crop));
+    if (!s_present_crop_cb(io, &crop)) return 0;
+    if (crop.crop_h == 0u || crop.crop_h >= io->height ||
+        crop.crop_y >= io->height || crop.crop_h > io->height - crop.crop_y)
+        return 0;
+    if (crop.aspect_num > 0 && crop.aspect_den > 0) {
+        if (out_num) *out_num = crop.aspect_num;
+        if (out_den) *out_den = crop.aspect_den;
+    } else {
+        psx_present_cropped_aspect(bn, bd, io->height, crop.crop_h,
+                                   out_num, out_den);
+    }
+    io->display_y += crop.crop_y;
+    io->height = crop.crop_h;
+    if (io->screen_height > crop.crop_h)
+        io->screen_height = crop.crop_h;
+    return 1;
+}
