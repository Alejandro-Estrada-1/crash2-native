+/* Optional presentation-only vertical crop adjustment registered by a title
+ * (e.g. from a constructor) to trim built-in top/bottom overscan borders at
+ * display time without mutating VRAM, savestates, GPU state, or guest timing. */
+typedef struct {
+    uint32_t crop_y;    /* top rows skipped inside [0, info->height) */
+    uint32_t crop_h;    /* active rows presented (1 <= crop_h < info->height) */
+    int      aspect_num;/* optional exact presentation aspect, or 0 for auto */
+    int      aspect_den;/* optional exact presentation aspect, or 0 for auto */
+} PsxDisplayPresentCrop;
+
+typedef int (*PsxDisplayPresentCropCb)(const GpuDisplayInfo *info,
+                                       PsxDisplayPresentCrop *out);
+
+void gpu_set_present_crop_callback(PsxDisplayPresentCropCb cb);
+int  gpu_apply_present_crop(GpuDisplayInfo *io, int base_num, int base_den,
+                            int *out_num, int *out_den);
+
 #ifdef __cplusplus
 }
 #endif
