diff --git a/runtime/include/gpu.h b/runtime/include/gpu.h
index 14ca26d4..34787adf 100644
--- a/runtime/include/gpu.h
+++ b/runtime/include/gpu.h
@@ -787,6 +787,18 @@ void gpu_set_present_crop_callback(PsxDisplayPresentCropCb cb);
 int  gpu_apply_present_crop(GpuDisplayInfo *io, int base_num, int base_den,
                             int *out_num, int *out_den);
 
+/* Optional title override for GTE projection aspect in squash mode (mode == 1).
+ * Receives the host display aspect `disp_num:disp_den` and outputs the effective
+ * 4:3-relative projection aspect `proj_num:proj_den` passed to
+ * gte_set_display_aspect() and gpu_ws_configure() (return non-zero to override). */
+typedef int (*PsxWsProjectionAspectCb)(int disp_num, int disp_den,
+                                       int *proj_num, int *proj_den);
+
+void gpu_set_widescreen_projection_aspect_callback(PsxWsProjectionAspectCb cb);
+int  gpu_apply_widescreen_projection_aspect(int disp_num, int disp_den,
+                                            int *proj_num, int *proj_den);
+void psx_ws_refresh_projection_live(void);
+
 #ifdef __cplusplus
 }
 #endif
diff --git a/runtime/src/gpu.c b/runtime/src/gpu.c
index 02805dd8..11abe8ad 100644
--- a/runtime/src/gpu.c
+++ b/runtime/src/gpu.c
@@ -8734,3 +8734,26 @@ int gpu_apply_present_crop(GpuDisplayInfo *io, int base_num, int base_den,
         io->screen_height = crop.crop_h;
     return 1;
 }
+
+static PsxWsProjectionAspectCb s_ws_proj_aspect_cb = NULL;
+
+void gpu_set_widescreen_projection_aspect_callback(PsxWsProjectionAspectCb cb) {
+    s_ws_proj_aspect_cb = cb;
+}
+
+int gpu_apply_widescreen_projection_aspect(int disp_num, int disp_den,
+                                           int *proj_num, int *proj_den) {
+    int out_n = 0, out_d = 0;
+    if (!s_ws_proj_aspect_cb || disp_num <= 0 || disp_den <= 0 ||
+        !proj_num || !proj_den)
+        return 0;
+    out_n = *proj_num;
+    out_d = *proj_den;
+    if (!s_ws_proj_aspect_cb(disp_num, disp_den, &out_n, &out_d))
+        return 0;
+    if (out_n <= 0 || out_d <= 0 || (int64_t)out_n * 3 < (int64_t)out_d * 4)
+        return 0;
+    *proj_num = out_n;
+    *proj_den = out_d;
+    return 1;
+}
diff --git a/runtime/src/main.cpp b/runtime/src/main.cpp
