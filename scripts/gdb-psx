#!/usr/bin/env bash
# gdb-psx: GDB wrapper for PCSX-Redux's GDB server, with timeout handling.
#
# Usage:
#   scripts/gdb-psx -batch -x re/experiments/NNN-description.gdb
#
# Environment variables:
#   PSX_GDB_PORT     PCSX-Redux GDB server port (check emulator settings)
#   PSX_GDB_TIMEOUT  seconds before aborting (default: 20)
#   GDB              GDB binary (default: gdb)
#
# On exit (normal completion, timeout, or SIGKILL), this script sends the RSP
# "c" packet ($c#63) over TCP to ensure the emulator is not left paused: in
# PCSX-Redux, "D" (detach) does not resume execution, whereas "c" resumes it
# (and is harmless if already running). On timeout (e.g., a breakpoint that
# never hits), it exits with code 124, including when GDB ignores SIGINT and
# must be terminated with SIGKILL 5s later.
#
# Uses flock serialization: if another experiment is active, waits up to 5 min.
#
# Experiment caveat: PCSX-Redux reports any CPU exception stop (such as the
# exception vector at 0x80000080) as T05 (SIGTRAP) over the GDB server; a
# "continue" in a .gdb script may stop there before the target breakpoint.
#
# Immediately after "target remote", checks connection state (if $_thread == 0,
# aborts at once with code 86 without dumping BIOS or resuming) and dumps the
# first 0x1000 bytes (4 KiB) of the BIOS ROM (0xbfc00000..0xbfc01000) to a
# temporary file. After GDB exits, bash computes and prints
# "BIOS sha256 (0xbfc00000+0x1000): <hash> (<name>)" (or "(unknown)" if absent
# from the table, or "UNAVAILABLE ..." if dumping fails), then removes the file.
# The BIOS dump runs within PSX_GDB_TIMEOUT.

set -uo pipefail

PORT="${PSX_GDB_PORT:?Set PSX_GDB_PORT to the PCSX-Redux GDB server port}"
TIMEOUT="${PSX_GDB_TIMEOUT:-20}"
GDB="${GDB:-gdb}"

# Lock: serialize emulator access to one experiment at a time.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/crash2-native-gdb.lock"
exec 9>"${LOCK}"
if ! flock -w 300 9; then
  echo "gdb-psx: emulator has been locked by another experiment for 5 minutes; aborting." >&2
  exit 75
fi

GDB_INIT=(
  -q -nx
  -iex "set architecture mips:3000"
  -iex "set pagination off"
  -iex "set confirm off"
  # Do not retry TCP for 15s when the GDB server is not listening.
  -iex "set tcp auto-retry off"
  -iex "set tcp connect-timeout 3"
  # PCSX-Redux advertises PacketSize=47ff, but memory dumps hang unless
  # memory-read packet size is bounded before "target remote".
  -iex "set remote memory-read-packet-size 256"
  -ex  "target remote localhost:${PORT}"
)

# Send "$c#63" (continue, checksum 0x63) over TCP and wait for the stub's "+" ACK.
# Harmless if already running and required if left paused after "D" or timeout.
resume_emulator() {
  local port="$1"
  timeout 5 bash -c '
    set -uo pipefail
    exec 3<>"/dev/tcp/localhost/$1" 2>/dev/null || exit 1
    for _ in 1 2 3; do
      printf '\''$c#63'\'' >&3 2>/dev/null || exit 1
      i=0
      while [ "${i}" -lt 64 ] && IFS= read -r -t 2 -n 1 ch <&3; do
        i=$((i + 1))
        case "${ch}" in
          "+") exit 0 ;;
          "-") break ;;
        esac
      done
    done
    exit 1
  ' _ "${port}"
}

# Hash the first 4 KiB of the BIOS: GDB only dumps to a temp file and bash
# hashes it afterward (never use "shell" inside GDB: under timeout, GDB is in a
# background process group and any child subshell blocks).
print_bios_sha256() {
  local rom="$1"
  local hash name
  if [ -f "${rom}" ] && [ "$(stat -c %s -- "${rom}")" -eq 4096 ]; then
    hash="$(sha256sum -- "${rom}" | cut -d' ' -f1)"
    case "${hash}" in
      d9908265377045f1b62638e8b54b558fec7bb13d840b8122dec36d19c1b10d89)
        name="OpenBIOS psxrecomp 55fbf04" ;;
      870563babc435b1027ab59237eb150e2f95ffe385f9d29830f45e1e038fc351e)
        name="OpenBIOS PCSX-Redux build 561" ;;
      *)
        name="unknown" ;;
    esac
    printf 'BIOS sha256 (0xbfc00000+0x1000): %s (%s)\n' "${hash}" "${name}"
  else
    printf 'BIOS sha256 (0xbfc00000+0x1000): UNAVAILABLE (could not dump 0xbfc00000..0xbfc01000)\n'
  fi
  rm -f -- "${rom}"
}

BIOS_TMP="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/gdb-psx.XXXXXX")" || {
  echo "gdb-psx: failed to create temporary directory for BIOS dump." >&2
  exit 1
}
trap 'rm -rf -- "${BIOS_TMP}"' EXIT
# GDB does not accept unescaped spaces or quotes in the "dump" filename.
case "${BIOS_TMP}" in
  *[!A-Za-z0-9/._-]*)
    echo "gdb-psx: temporary path '${BIOS_TMP}' contains unsupported characters for GDB; set XDG_RUNTIME_DIR." >&2
    exit 1 ;;
esac
# In GDB -batch, a failed "target remote" does not abort subsequent -ex/-x args.
# If $_thread is still 0 after connecting, quit immediately with code 86 without
# running "shell" before the BIOS dump or experiment script.
CHECK_CONNECT="${BIOS_TMP}/check_connect.gdb"
cat > "${CHECK_CONNECT}" <<'EOF'
if $_thread == 0
  quit 86
end
EOF

BIOS_ROM="${BIOS_TMP}/bios.bin"
BIOS_HASH=(
  -ex "dump binary memory ${BIOS_ROM} 0xbfc00000 0xbfc01000"
)

start_sec=${SECONDS}
timeout --signal=INT --kill-after=5 "${TIMEOUT}" "${GDB}" "${GDB_INIT[@]}" -x "${CHECK_CONNECT}" "${BIOS_HASH[@]}" "$@"
status=$?

if [ "${status}" -eq 86 ]; then
  echo "gdb-psx: error: failed to connect to GDB server at localhost:${PORT} (is PCSX-Redux open with GDB enabled?)." >&2
  exit 1
fi

# timeout exits 124 if GDB stops on SIGINT. If GDB ignores SIGINT, after 5s
# --kill-after sends SIGKILL to the whole group (timeout included -> exit 137).
# An exit code of 137 before TIMEOUT elapsed indicates an external SIGKILL.
if [ "${status}" -eq 124 ] ||
   { [ "${status}" -eq 137 ] && [ $((SECONDS - start_sec)) -ge "${TIMEOUT}" ]; }; then
  echo "gdb-psx: TIMEOUT after ${TIMEOUT}s. Experiment did not reach its success criteria." >&2
  [ "${status}" -eq 137 ] && echo "gdb-psx: GDB ignored SIGINT and was killed with SIGKILL." >&2
  status=124
elif [ "${status}" -eq 137 ]; then
  echo "gdb-psx: GDB terminated by SIGKILL before timeout." >&2
fi

print_bios_sha256 "${BIOS_ROM}"

if ! resume_emulator "${PORT}"; then
  echo "gdb-psx: WARNING: could not resume emulator (another client connected?); resume PCSX-Redux manually." >&2
fi

exit "${status}"
