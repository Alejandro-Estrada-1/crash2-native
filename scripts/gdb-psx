#!/usr/bin/env bash
# gdb-psx: GDB conectado al servidor GDB de PCSX-Redux, con timeout.
#
# Uso:
#   scripts/gdb-psx -batch -x re/experiments/NNN-descripcion.gdb
#
# Variables de entorno:
#   PSX_GDB_PORT     puerto del servidor GDB de PCSX-Redux (míralo en su configuración)
#   PSX_GDB_TIMEOUT  segundos antes de abortar (por defecto 20)
#   GDB              ejecutable de GDB (por defecto: gdb)
#
# Al terminar el experimento (ya sea de forma normal, por timeout o por SIGKILL),
# este script envía el paquete RSP "c" ($c#63) por TCP para asegurarse de que el
# emulador no quede en pausa: en PCSX-Redux, "D" (detach) no reanuda la ejecución,
# mientras que "c" sí la reanuda (y es inocuo si ya está corriendo). Si se agota el
# tiempo (p. ej. un breakpoint que nunca salta), sale con código 124, también si GDB
# ignoró el SIGINT y hubo que matarlo con SIGKILL 5 s después.
#
# Usa un candado (flock): si otro experimento está en curso, espera hasta 5 minutos.
#
# Advertencia para experimentos: PCSX-Redux notifica cualquier pausa por excepción
# de la CPU (p. ej. vector de excepciones en 0x80000080) como T05 (SIGTRAP) en el
# servidor GDB; un "continue" en el .gdb puede detenerse ahí antes del breakpoint
# esperado.
#
# Al conectarse, antes del experimento, vuelca los primeros 0x1000 bytes (4 KiB) de
# la ROM de la BIOS (0xbfc00000..0xbfc01000) a un temporal e imprime la línea
# "BIOS sha256 (0xbfc00000+0x1000): <hash> (<nombre>)" (o "(desconocida)" si no está
# en la tabla, o "NO DISPONIBLE ..." si el volcado falla). El temporal se borra en
# cuanto se calcula el hash, y un trap lo borra al salir si algo falla antes.
# El volcado cuenta dentro de PSX_GDB_TIMEOUT.

set -uo pipefail

PORT="${PSX_GDB_PORT:?Define PSX_GDB_PORT con el puerto del servidor GDB de PCSX-Redux}"
TIMEOUT="${PSX_GDB_TIMEOUT:-20}"
GDB="${GDB:-gdb}"

# Candado: un solo experimento a la vez contra el emulador.
LOCK="${XDG_RUNTIME_DIR:-/tmp}/crash2-native-gdb.lock"
exec 9>"${LOCK}"
if ! flock -w 300 9; then
  echo "gdb-psx: el emulador está ocupado por otro experimento desde hace 5 minutos; abortando." >&2
  exit 75
fi

GDB_INIT=(
  -q -nx
  -iex "set architecture mips:3000"
  -iex "set pagination off"
  -iex "set confirm off"
  # PCSX-Redux anuncia PacketSize=47ff pero el volcado de BIOS se cuelga sin
  # acotar la lectura de memoria antes de "target remote".
  -iex "set remote memory-read-packet-size 256"
  -ex  "target remote localhost:${PORT}"
)

# Envía "$c#63" (continue, checksum 0x63) por TCP y espera el ACK "+" del stub.
# Es inocuo si el emulador ya corre y necesario si quedó pausado tras "D" o timeout.
reanudar_emulador() {
  local port="$1"
  timeout 5 bash -c '
    set -uo pipefail
    exec 3<>"/dev/tcp/localhost/$1" 2>/dev/null || exit 1
    for _ in 1 2 3; do
      printf '\''$c#63'\'' >&3 2>/dev/null || exit 1
      i=0
      while [ "${i}" -lt 64 ] && IFS= read -r -t 2 -n 1 ch <&3; do
        i=$((i + 1))
        case "${ch}" in
          "+") exit 0 ;;
          "-") break ;;
        esac
      done
    done
    exit 1
  ' _ "${port}"
}

# Hash de los primeros 4 KiB de la BIOS: GDB solo los vuelca a un temporal y
# bash calcula el sha256 al terminar (sin usar "shell" dentro de GDB, porque
# bajo timeout queda en un grupo en segundo plano y cualquier subshell bloquea).
imprimir_bios_sha256() {
  local rom="$1"
  local hash nombre
  if [ -f "${rom}" ] && [ "$(stat -c %s -- "${rom}")" -eq 4096 ]; then
    hash="$(sha256sum -- "${rom}" | cut -d' ' -f1)"
    case "${hash}" in
      d9908265377045f1b62638e8b54b558fec7bb13d840b8122dec36d19c1b10d89)
        nombre="OpenBIOS psxrecomp 55fbf04" ;;
      870563babc435b1027ab59237eb150e2f95ffe385f9d29830f45e1e038fc351e)
        nombre="OpenBIOS PCSX-Redux build 561" ;;
      *)
        nombre="desconocida" ;;
    esac
    printf 'BIOS sha256 (0xbfc00000+0x1000): %s (%s)\n' "${hash}" "${nombre}"
  else
    printf 'BIOS sha256 (0xbfc00000+0x1000): NO DISPONIBLE (no se pudo volcar 0xbfc00000..0xbfc01000)\n'
  fi
  rm -f -- "${rom}"
}

BIOS_TMP="$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/gdb-psx.XXXXXX")" || {
  echo "gdb-psx: no pude crear el directorio temporal para el volcado de la BIOS." >&2
  exit 1
}
trap 'rm -rf -- "${BIOS_TMP}"' EXIT
# GDB no admite espacios ni comillas sin escapar en el nombre de archivo de "dump".
case "${BIOS_TMP}" in
  *[!A-Za-z0-9/._-]*)
    echo "gdb-psx: la ruta temporal '${BIOS_TMP}' tiene caracteres que GDB no acepta; define XDG_RUNTIME_DIR." >&2
    exit 1 ;;
esac
BIOS_ROM="${BIOS_TMP}/bios.bin"
BIOS_HASH=(
  -ex "dump binary memory ${BIOS_ROM} 0xbfc00000 0xbfc01000"
)

inicio=${SECONDS}
timeout --signal=INT --kill-after=5 "${TIMEOUT}" "${GDB}" "${GDB_INIT[@]}" "${BIOS_HASH[@]}" "$@"
status=$?

# timeout sale con 124 si GDB terminó tras el SIGINT. Si GDB lo ignora, a los 5 s
# --kill-after manda SIGKILL a todo el grupo, timeout incluido, y el código es 137.
# Un 137 antes de agotar el tiempo es un SIGKILL de otro origen.
if [ "${status}" -eq 124 ] ||
   { [ "${status}" -eq 137 ] && [ $((SECONDS - inicio)) -ge "${TIMEOUT}" ]; }; then
  echo "gdb-psx: TIMEOUT tras ${TIMEOUT}s. El experimento no llegó a su criterio de éxito." >&2
  [ "${status}" -eq 137 ] && echo "gdb-psx: GDB no respondió al SIGINT; se terminó con SIGKILL." >&2
  status=124
elif [ "${status}" -eq 137 ]; then
  echo "gdb-psx: GDB terminó por SIGKILL antes del timeout." >&2
fi

imprimir_bios_sha256 "${BIOS_ROM}"

if ! reanudar_emulador "${PORT}"; then
  echo "gdb-psx: AVISO: no pude reanudar el emulador (¿otro cliente conectado?); reanuda PCSX-Redux a mano." >&2
fi

exit "${status}"
